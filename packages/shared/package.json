{
  "name": "@wyrd-company/manifold-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types, JSON Schemas, and utilities shared by the Manifold service and host CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./comparator.d.ts": {
      "types": "./src/comparator.d.ts",
      "bun": "./src/comparator.d.ts",
      "default": "./dist/comparator.d.ts"
    },
    "./expressions": {
      "types": "./dist/expressions.d.ts",
      "import": "./dist/expressions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/comparator.d.ts dist/comparator.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "generate:blueprint-schema": "node scripts/generate-blueprint-schema.mjs && vp fmt src/blueprint-schema.ts",
    "generate:portfolio-schemas": "node scripts/generate-portfolio-schemas.mjs && vp fmt src/portfolio-declaration-schema.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "json-schema-faker": "^0.6.3",
    "jsonata": "^2.2.2",
    "xstate": "^5.33.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
