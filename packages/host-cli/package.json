{
  "name": "@wyrd-company/manifold-host-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The Manifold host CLI, a companion binary installed on each environment.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/cli.ts --compile --bytecode --outfile dist/manifold-host",
    "build:targets": "for target in linux-x64 linux-arm64 darwin-arm64 windows-x64; do bun build src/cli.ts --compile --bytecode --target=bun-$target --outfile dist/$target/manifold-host || exit 1; done",
    "typecheck": "pnpm --filter @wyrd-company/manifold-shared build && tsc --noEmit",
    "test": "pnpm --filter @wyrd-company/manifold-shared build && vp test run",
    "generate:comparator-library": "node scripts/generate-comparator-library.mjs && vp fmt src/comparator-lint/library.generated.ts"
  },
  "dependencies": {
    "@codeburn/core": "0.9.20",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@wyrd-company/manifold-shared": "workspace:*",
    "typescript": "catalog:",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "bun": "catalog:",
    "vite-plus": "catalog:"
  }
}
