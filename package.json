{
  "name": "@wyrd-company/manifold",
  "version": "0.0.0",
  "private": true,
  "description": "Process workflow engine for agentic work.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyrd-company/manifold.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
